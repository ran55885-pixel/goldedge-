# Aurum Nexus secrets - copy this file to ".env" and fill in. NEVER commit or zip .env.
# Secrets are read only from this file / environment variables, or typed at runtime.

# --- MT5 account passwords (one per account; the variable name is set in accounts.yaml -> password_env)
MT5_PASSWORD_DEMO1=
MT5_PASSWORD_DEMO2=
MT5_PASSWORD_REAL1=

# --- OANDA v20 (secondary price source). Create a free practice account, then "Manage API Access".
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice

# --- Dashboard
# Optional static API token (header "Authorization: Bearer <token>" or ?token=). Leave empty to disable.
DASHBOARD_TOKEN=
# Optional: pre-seed the first-run dashboard user (otherwise you create it in the browser on first run).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- TradingView webhook alerts (optional extra signal input). Put the same secret inside the alert JSON.
TRADINGVIEW_WEBHOOK_SECRET=

# --- FRED (optional; without a key the public CSV endpoint is used)
FRED_API_KEY=
